{
  "name": "spectrum",
  "private": true,
  "version": "0.1.0",
  "description": "Spectrum — AI Code Editor with free model support (Gemma, etc.)",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh": "cross-env GITHUB_PAGES=true tsc -b && cross-env GITHUB_PAGES=true vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "predeploy": "npm run build:gh",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "latest",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.52.2",
    "pyodide": "^314.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.2"
  },
  "keywords": [
    "ai",
    "code-editor",
    "cursor",
    "monaco",
    "electron",
    "free-models"
  ],
  "author": "Spectrum",
  "license": "MIT"
}
